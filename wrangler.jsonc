// One Worker: static assets for the page (the Next export in out/), and the
// cron in worker/src/index.ts that indexes the chain into the STATS bucket.
// The bucket is public at https://data.decdn.org, and the page fetches its
// stats file from there in the browser.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stats",
  // the scheduled handler, plus a fetch fallback to the assets
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
  },
  "triggers": { "crons": ["*/10 * * * *"] },
  "r2_buckets": [
    // stats-<CHAIN_ID>.json: written by the cron, served publicly on
    // data.decdn.org (lib/stats.tsx). The browser fetch needs the bucket's
    // CORS policy, r2-cors.json.
    { "binding": "STATS", "bucket_name": "decdn-stats" },
  ],
  // RPC_URL is a secret (`wrangler secret put RPC_URL`; `.env` locally).
  // CHAIN_ID also names the file the page fetches: keep lib/stats.tsx in step.
  "vars": {
    "CHAIN_ID": "421614",
    "FEE_ROUTER": "0xe0510f9350ef9D34E576ccf4d9043f1FC30cf17D",
    "START_BLOCK": "310903026",
    "CAPACITY_BOND": "0x65a9e38F41B9bE2fcB97950a0E3c33e506E6E353",
    "PAYMENT_POOL": "0x351E5544471e11638b89DF8E3A3299c28E00cEc3",
    "LOG_CHUNK_BLOCKS": "10000",
    "MAX_CHUNKS_PER_RUN": "20",
    "CONFIRMATIONS": "1200",
  },
  // Branch Previews (`wrangler preview`, Workers Builds' non-production
  // deploy) inherit no vars or bindings except the assets and their ASSETS
  // binding, and run no cron. The page needs nothing else, so the block is
  // empty; `wrangler preview` still requires it to exist.
  "previews": {},
  "observability": { "enabled": true },
}
