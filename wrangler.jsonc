// One Worker: the Next app (built by @opennextjs/cloudflare) serves the page,
// and the cron in worker/src/index.ts indexes the chain into the STATS bucket
// the page reads.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stats",
  // wraps the generated .open-next/worker.js and adds the scheduled handler
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "stats" }],
  "triggers": { "crons": ["*/10 * * * *"] },
  "r2_buckets": [
    // ISR cache for the page's 60s revalidate (open-next.config.ts). Deploys
    // create the bucket if it's missing.
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "decdn-stats-cache" },
    // stats-<CHAIN_ID>.json: written by the cron, read by the page
    { "binding": "STATS", "bucket_name": "decdn-stats" }
  ],
  // RPC_URL is a secret (`wrangler secret put RPC_URL`; `.env` locally).
  "vars": {
    "CHAIN_ID": "421614",
    "FEE_ROUTER": "0xe0510f9350ef9D34E576ccf4d9043f1FC30cf17D",
    "START_BLOCK": "310903026",
    "CAPACITY_BOND": "0x65a9e38F41B9bE2fcB97950a0E3c33e506E6E353",
    "PAYMENT_POOL": "0x351E5544471e11638b89DF8E3A3299c28E00cEc3",
    "LOG_CHUNK_BLOCKS": "10000",
    "MAX_CHUNKS_PER_RUN": "20",
    "CONFIRMATIONS": "1200"
  },
  // Branch Previews (`wrangler preview`, Workers Builds' non-production
  // deploy) inherit no vars or bindings and run no cron, so a Preview is just
  // the page: CHAIN_ID and the two buckets it reads. Both are production's on
  // purpose — the page only reads STATS, and cache keys are prefixed by build
  // ID. WORKER_SELF_REFERENCE is left out: a Preview's service binding calls
  // production, not the Preview, so there the memory queue skips ISR
  // revalidation.
  "previews": {
    "vars": { "CHAIN_ID": "421614" },
    "r2_buckets": [
      {
        "binding": "NEXT_INC_CACHE_R2_BUCKET",
        "bucket_name": "decdn-stats-cache"
      },
      { "binding": "STATS", "bucket_name": "decdn-stats" }
    ]
  },
  "observability": { "enabled": true }
}
