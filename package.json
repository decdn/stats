{
  "name": "test-stats-page",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm cf-typegen && opennextjs-cloudflare build",
    "start": "next start",
    "app:preview": "pnpm build && opennextjs-cloudflare preview",
    "app:deploy": "pnpm build && opennextjs-cloudflare deploy",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,css,md,yaml,yml}\"",
    "typecheck": "tsc --noEmit",
    "index": "tsx worker/src/tick.ts",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "pretypecheck": "pnpm cf-typegen",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,jsonc,md,css,yaml,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "aws4fetch": "^1.0.20",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.42.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "3.8.0",
    "tw-animate-css": "^1.4.0",
    "viem": "^2.56.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@opennextjs/cloudflare": "^1.20.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "^4.135.0"
  }
}
