# copy to .env — read by `pnpm dev` (next) and `pnpm worker:dev` (wrangler --env-file ../.env)

# --- next ---
# where the app reads stats.json from. local: the worker serves the emulated
# bucket at http://localhost:8787/stats.json. prod: the bucket's public URL
# (or the deployed worker's /stats.json).
STATS_URL=http://localhost:8787/stats.json

# --- worker ---
# arbitrum sepolia (chain 421614) json-rpc — NOT arb1.arbitrum.io, that's mainnet.
# the public endpoint below works but is rate-limited; alchemy/quicknode are faster.
RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
# L2 block to start indexing from — the FeeRouter deployment block. must match
# the FEE_ROUTER in worker/wrangler.jsonc; the worker resets stats.json whenever
# either changes. note `deployBlock` in decdn/contracts/deployments/421614.json
# is an L1 number and cannot be used here.
START_BLOCK=310903026

# --- r2 (tests / local runs against the real bucket) ---
# leave these empty to use the bucket *binding* from worker/wrangler.jsonc —
# in prod that's the real bucket, under `wrangler dev` a local emulation.
# set them to talk to the real bucket over R2's S3 API from a local run.
# they come from the cloudflare dashboard: R2 → Manage R2 API Tokens.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_S3_ENDPOINT=      # https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=decdn-stats
# the token *value* from the same screen is a cloudflare API token, not an S3
# credential — only needed as CLOUDFLARE_API_TOKEN for non-interactive
# `wrangler deploy` (CI). in prod set RPC_URL with `wrangler secret put RPC_URL`.
