# copy to .env — read by `pnpm dev` (next) and `pnpm index` (one cron tick),
# on top of the vars in wrangler.jsonc. CHAIN_ID, the contract addresses and
# START_BLOCK live there; don't repeat them here, a .env value overrides them.

# arbitrum sepolia (chain 421614) json-rpc — NOT arb1.arbitrum.io, that's mainnet.
# the public endpoint below works but is rate-limited; alchemy/quicknode are faster.
# in prod it's a secret: `wrangler secret put RPC_URL`.
RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# --- r2 (local runs against the real bucket) ---
# leave these empty to use the STATS bucket *binding* from wrangler.jsonc — in
# prod that's the real bucket, locally an emulation in .wrangler/state shared
# by `pnpm index` and `pnpm dev`. set them to talk to the real bucket over
# R2's S3 API instead (both the indexer and the page then use it).
# they come from the cloudflare dashboard: R2 → Manage R2 API Tokens.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_S3_ENDPOINT=      # https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=decdn-stats
# the token *value* from the same screen is a cloudflare API token, not an S3
# credential — only needed as CLOUDFLARE_API_TOKEN for non-interactive
# `wrangler deploy` (CI).
