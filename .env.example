# copy to .env — read by `pnpm dev` (next) and `pnpm worker:dev` (wrangler --env-file ../.env)

# --- next ---
# where the app reads stats.json from. local: the worker serves the emulated
# bucket at http://localhost:8787/stats.json. prod: the bucket's public URL
# (or the deployed worker's /stats.json).
STATS_URL=http://localhost:8787/stats.json

# --- worker ---
# arbitrum sepolia json-rpc. the public https://sepolia-rollup.arbitrum.io/rpc
# is rate-limited; use alchemy/quicknode/etc.
RPC_URL=
# L2 block to start indexing from (FeeRouter deployment block). note that
# `deployBlock` in decdn/contracts/deployments/421614.json is an L1 number —
# take the block of the contract-creation tx from arbiscan instead.
START_BLOCK=

# R2 needs no keys here: the worker uses a bucket binding (worker/wrangler.jsonc,
# bucket "decdn-stats"). `wrangler dev` emulates it locally under worker/.wrangler/;
# `wrangler login` authorizes `wrangler dev --remote` and `wrangler deploy`.
# in prod set RPC_URL with `wrangler secret put RPC_URL` and START_BLOCK as a var.
